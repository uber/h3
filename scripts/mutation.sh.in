set -e

if [[ $<BOOL:$<CONFIG:Debug>> != 1 ]]; then
    echo "Cannot run mutation for non-debug build" 1>&2
    exit 1
fi

src_dir=${1:-"Missing source directory"}
binary_dir=${2:-"Missing binary directory"}

MULL_ENV="$src_dir/mull.yml" "${MULL_ROOT}/mull-reporter-${MULL_VERSION}" h3-mutation-report/h3-report.sqlite
